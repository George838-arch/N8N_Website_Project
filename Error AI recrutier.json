      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nconst now = new Date();\nconst TWO_HOURS = 2 * 60 * 60 * 1000;\n\nfunction parseDate(value) {\n  if (!value) return null;\n\n  const date = new Date(\n    String(value).replace(\" \", \"T\") + \":00+02:00\"\n  );\n\n  return isNaN(date.getTime()) ? null : date;\n}\n\n// Process all candidates\nconst candidates = items.map(item => {\n  const candidate = item.json;\n  const appliedDate = parseDate(candidate[\"apllied at?\"]);\n\n  const elapsed = appliedDate\n    ? now.getTime() - appliedDate.getTime()\n    : null;\n\n  const twoHoursPassed =\n    elapsed !== null && elapsed >= TWO_HOURS;\n\n  const alreadyProcessed =\n    String(candidate.status || \"\").toLowerCase() === \"done\";\n\n  const shouldExecute =\n    twoHoursPassed && !alreadyProcessed;\n\n  return {\n    ...candidate,\n\n    elapsed_hours: elapsed !== null\n      ? Number((elapsed / 3600000).toFixed(2))\n      : null,\n\n    two_hours_passed: twoHoursPassed,\n    already_processed: alreadyProcessed,\n    workflow_should_execute: shouldExecute,\n\n    message: shouldExecute\n      ? \"Ready to process this application.\"\n      : alreadyProcessed\n        ? \"This application was already processed.\"\n        : appliedDate\n          ? \"Waiting for 2 hours to pass.\"\n          : \"Invalid application date.\"\n  };\n});\n\n// Get candidates ready for processing\nconst eligibleCandidates = candidates.filter(\n  candidate => candidate.workflow_should_execute\n);\n\nreturn [{\n  json: {\n    current_time: now.toISOString(),\n\n    total_candidates: candidates.length,\n\n    eligible_count: eligibleCandidates.length,\n\n    workflow_should_execute: eligibleCandidates.length > 0,\n\n    candidates,\n\n    eligible_candidates: eligibleCandidates\n  }\n}];\n"
      },
