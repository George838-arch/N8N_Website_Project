        "message": "=\n<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n</head>\n<body style=\"margin:0;padding:25px;background:#f3f4f6;font-family:Arial,sans-serif;color:#333;\">\n\n<div style=\"max-width:700px;margin:auto;background:white;border-radius:10px;overflow:hidden;\">\n\n  <div style=\"background:#1e3a8a;color:white;padding:25px;\">\n    <h2>AI Recruiter Monitoring Report</h2>\n    <p>Workflow Execution Monitoring</p>\n  </div>\n\n  <div style=\"padding:25px;\">\n\n    <div style=\"padding:18px;border-radius:8px;background:{{ $json.eligible_count > 0 ? '#fef2f2' : '#ecfdf5' }};\">\n      <h3 style=\"margin-top:0;color:{{ $json.eligible_count > 0 ? '#b91c1c' : '#047857' }};\">\n        {{ $json.eligible_count > 0 ? 'Workflow Execution Alert!' : 'All Applications Processed' }}\n      </h3>\n\n      <p>\n        {{ $json.eligible_count > 0\n          ? 'Some applications have exceeded the 2-hour processing limit without execution.'\n          : 'No pending applications were found. All checked candidates have already been processed or are still within the allowed time.' }}\n      </p>\n    </div>\n\n    <h3>Monitoring Summary</h3>\n\n    <p><strong>Total Candidates:</strong> {{ $json.total_candidates }}</p>\n    <p><strong>Stuck Candidates:</strong> {{ $json.eligible_count }}</p>\n    <p><strong>Check Time:</strong> {{ $json.current_time }}</p>\n    <p><strong>Expected Processing Time:</strong> 2 Hours</p>\n\n    <h3>Candidate Details</h3>\n\n    {{ $json.eligible_count > 0\n      ? `<table style=\"width:100%;border-collapse:collapse;\">\n          <tr style=\"background:#f3f4f6;\">\n            <th style=\"padding:10px;text-align:left;\">Name</th>\n            <th style=\"padding:10px;text-align:left;\">Position</th>\n            <th style=\"padding:10px;text-align:left;\">Applied At</th>\n            <th style=\"padding:10px;text-align:left;\">Waiting Hours</th>\n          </tr>\n          ${$json.eligible_candidates.map(c => `\n            <tr>\n              <td style=\"padding:10px;border-bottom:1px solid #eee;\">${c.name}</td>\n              <td style=\"padding:10px;border-bottom:1px solid #eee;\">${c.position}</td>\n              <td style=\"padding:10px;border-bottom:1px solid #eee;\">${c['apllied at?']}</td>\n              <td style=\"padding:10px;border-bottom:1px solid #eee;\">${c.elapsed_hours}</td>\n            </tr>\n          `).join('')}\n        </table>`\n      : `<p style=\"padding:15px;background:#f0fdf4;color:#166534;border-radius:6px;\">\n          No stuck candidates detected.\n        </p>`\n    }}\n\n    <hr style=\"border:0;border-top:1px solid #eee;margin:25px 0;\">\n\n    <p style=\"font-size:12px;color:#888;text-align:center;\">\n      Automatically generated by AI Recruiter Monitoring System.\n    </p>\n\n  </div>\n</div>\n\n</body>\n</html>\n",
