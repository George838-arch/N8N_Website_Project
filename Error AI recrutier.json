    {
      "parameters": {
        "jsCode": "\n// ALERT THROTTLING\n// One email per problem per hour\n// n8n Code Node\n// Mode: Run Once for All Items\n\nconst rows = $input.all();\n\nconst WINDOW_MINUTES = 60;\n\n// Get the latest error from the input\nconst err = rows[rows.length - 1].json;\n\nconst num = v => Number(String(v ?? '').replace(/,/g, ''));\n\nconst fingerprint = String(err.Fingerprint ?? '').trim();\nconst currentMinute = num(err['Epoch Minute']);\n\n// Check previous rows with the same fingerprint\nconst alertedRecently = rows.slice(0, -1).some(item => {\n  const row = item.json;\n\n  const sameFingerprint =\n    String(row.Fingerprint ?? '').trim() === fingerprint;\n\n  const wasAlerted =\n    row.Alerted === true ||\n    String(row.Alerted).toLowerCase() === 'yes';\n\n  const minutesPassed =\n    currentMinute - num(row['Epoch Minute']);\n\n  return (\n    sameFingerprint &&\n    wasAlerted &&\n    minutesPassed >= 0 &&\n    minutesPassed < WINDOW_MINUTES\n  );\n});\n\n// Critical errors email now; warnings wait for daily digest\nlet alerted = 'digest only';\n\nif (err.Severity === 'CRITICAL' || err.Severity === 'HIGH') {\n  alerted = alertedRecently ? 'throttled' : 'yes';\n}\n\nreturn [{\n  json: {\n    ...err,\n    alerted,\n    alertedRecently,\n    sendNow: alerted === 'yes',\n    throttleWindowMinutes: WINDOW_MINUTES,\n    status: alertedRecently ? 'THROTTLED' : 'CHECKED'\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        656,
        0
      ],
      "id": "115453a4-3dd2-4a37-bb9a-d084df7f59b7",
      "name": "Check duplication last 24 Hours",
      "executeOnce": false,
      "retryOnFail": false,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "\n// AI RECRUITER - DAILY ERROR DIGEST\n\nconst items = $input.all();\nconst now = new Date();\nconst cutoff = now.getTime() - (24 * 60 * 60 * 1000);\n\nconst recentErrors = items\n  .map(item => item.json)\n  .filter(error => {\n    const date = new Date(String(error.Time).replace(\" \", \"T\"));\n\n    return !isNaN(date.getTime()) &&\n      date.getTime() >= cutoff &&\n      date.getTime() <= now.getTime();\n  });\n\n// Group errors by fingerprint\nconst grouped = {};\n\nfor (const error of recentErrors) {\n  const fingerprint = error.Fingerprint || \"UNKNOWN\";\n\n  if (!grouped[fingerprint]) {\n    grouped[fingerprint] = {\n      fingerprint,\n      workflow: error.Workflow,\n      node: error.Node,\n      type: error.Type,\n      severity: error.Severity,\n      message: error.Message,\n      suggested_fix: error[\"Suggested Fix\"],\n      occurrences: []\n    };\n  }\n\n  grouped[fingerprint].occurrences.push({\n    time: error.Time,\n    execution_id: error[\"Execution ID\"],\n    execution_link: error[\"Execution Link\"],\n    status: error.Status\n  });\n}\n\nconst errors = Object.values(grouped);\n\nreturn [{\n  json: {\n    report_date: now.toISOString(),\n    period: \"Last 24 Hours\",\n    total_occurrences: recentErrors.length,\n    unique_errors: errors.length,\n    has_errors: errors.length > 0,\n    errors\n  }\n}];\n"
      },
