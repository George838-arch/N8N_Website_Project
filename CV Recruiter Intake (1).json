    {
      "parameters": {
        "jsCode": "const form = $('On form submission').first();\nconst bin = form.binary || {};\nconst key = Object.keys(bin)[0];\nif (!key) throw new Error('No CV file found');\nconst clean = s => String(s).replace(/[\\\\/:*?\"<>|]/g, '').trim();\nconst date = new Date().toISOString().slice(0, 10);\nconst fileName = `${clean(form.json['What is your name?'])} - ${clean(form.json['Position you will apply'])} - ${date}.pdf`;\nreturn [{ json: { fileName }, binary: { CV: bin[key] } }];"
      },
