    {
      "parameters": {
        "jsCode": "\nconst data = $json;\n\n// ===============================\n// 1. NAME VALIDATION\n// ===============================\n\nconst fullName = String(data[\"What is your name?\"] || \"\").trim();\nconst nameParts = fullName.split(/\\s+/).filter(Boolean);\n\nconst firstName = nameParts[0] || \"\";\nconst lastName = nameParts.slice(1).join(\" \");\n\nconst nameValid =\n  firstName.length > 3 &&\n  lastName.length > 0;\n\n// ===============================\n// 2. EMAIL VALIDATION\n// ===============================\n\nconst email = String(data[\"What is your email?\"] || \"\")\n  .trim()\n  .toLowerCase();\n\nconst emailValid =\n  /^[a-zA-Z0-9._%+-]+@gmail\\.com$/.test(email);\n\n// ===============================\n// 4. CV SIZE VALIDATION\n// ===============================\n\nconst cv = data.CV || {};\n\nconst cvSize = Number(cv.size || 0);\n\nconst MIN_SIZE = 5 * 1024;           // 5 KB\nconst MAX_SIZE = 50 * 1024 * 1024;  // 50 MB\n\nconst cvSizeValid =\n  cvSize >= MIN_SIZE &&\n  cvSize <= MAX_SIZE;\n\n// ===============================\n// 5. CV FILE TYPE\n// ===============================\n\nconst cvTypeValid =\n  cv.mimetype === \"application/pdf\";\n\n// ===============================\n// 6. FINAL VALIDATION\n// ===============================\n\nconst validations = {\n  name_valid: nameValid,\n  email_valid: emailValid,\n  cv_size_valid: cvSizeValid,\n  cv_type_valid: cvTypeValid\n};\n\nconst isValid = Object.values(validations).every(Boolean);\n\n// ===============================\n// 7. RETURN ALL DATA\n// ===============================\n\nreturn {\n  json: {\n    ...data,\n\n    first_name: firstName,\n    last_name: lastName,\n\n\n    cv_size_kb: Number((cvSize / 1024).toFixed(2)),\n    cv_size_mb: Number((cvSize / (1024 * 1024)).toFixed(2)),\n\n    validations,\n\n    valid: isValid,\n\n    validation_errors: [\n      ...(!nameValid ? [\"Name must contain first and last name, and first name must exceed 3 characters.\"] : []),\n      ...(!emailValid ? [\"Email must end with @gmail.com.\"] : []),\n      ...(!cvSizeValid ? [\"CV size must be between 5 KB and 50 MB.\"] : []),\n      ...(!cvTypeValid ? [\"CV must be a PDF file.\"] : [])\n    ]\n  }\n};\n"
      },
