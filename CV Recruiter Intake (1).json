    {
      "parameters": {
        "jsCode": "const f = $('On form submission').first().json;\n\nconst normalize = value =>\n  String(value ?? '').trim().toLowerCase();\n\nconst email = normalize(f['What is your email?']);\nconst position = normalize(f['Position you will apply']);\n\nconst rows = $('Get row(s) in sheet').all().map(item => item.json);\n\nconst duplicate = rows.find(row =>\n  normalize(row.email) === email &&\n  normalize(row.position) === position\n);\n\nconst isDuplicate = Boolean(duplicate);\n\nreturn [\n  {\n    json: {\n      ...f,\n\n      isDuplicate,\n\n      duplicateStatus: isDuplicate ? 'DUPLICATE' : 'NEW',\n\n      duplicateExplanation: isDuplicate\n        ? `Applicant already applied for ${position} using ${email}.`\n        : 'No duplicate application found. Applicant can proceed.',\n\n      duplicateDetails: duplicate\n        ? {\n            matchedEmail: duplicate.email,\n            matchedPosition: duplicate.position,\n            matchedRowNumber: duplicate.row_number ?? null\n          }\n        : null\n    }\n  }\n];"
      },
