      "parameters": {
        "jsCode": "const f = $('On form submission').first().json;\nconst n = x => String(x || '').trim().toLowerCase();\nconst email = n(f['What is your email?']);\nconst pos = n(f['Position you will apply']);\nconst rows = $('Get row(s) in sheet').all().map(i => i.json);\nconst isDuplicate = rows.some(r => n(r.email) === email && n(r.position) === pos);\nreturn [{ json: { isDuplicate } }];"
      },
