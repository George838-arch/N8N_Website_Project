    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst bin = $input.first().binary || {};\nconst errors = [];\nconst name = String(d['What is your name?'] || '').trim();\nconst email = String(d['What is your email?'] || '').trim();\nif (name.length < 3) errors.push('Name must be at least 3 characters.');\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) errors.push('Email is not valid.');\nif (!Object.keys(bin).length) errors.push('Please upload your CV.');\n\nconst isValid = errors.length === 0;\n\nreturn [{\n  json: {\n    isValid,\n    status: isValid ? 'new' : 'invalid',\n    errorText: errors.join(' | ')\n  }\n}];"
      },
